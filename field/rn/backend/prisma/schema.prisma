datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum DeviceType {
  WATCH
  HR_BAND
  BIKE_COMPUTER
  OTHER
}

enum DeviceBrand {
  POLAR
  GARMIN
  COROS
  SUUNTO
  FITBIT
  OTHER
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  devices   Device[]
}

model Token {
  id                  Int      @id @default(autoincrement())
  token               String   @unique
  tokenType           String
  expiresIn           Int
  code                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  brandAccountId      Int
  brandAccount        BrandAccount     @relation(fields: [brandAccountId], references: [id])
}

model Device {
  id             Int           @id @default(autoincrement())
  userId         Int
  type           DeviceType
  brandName      DeviceBrand
  brandIdAccount Int?
  model          String?
  serial         String?       @unique
  connectedAt    DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id])
  brand          BrandAccount? @relation(fields: [brandIdAccount], references: [id])
}

model BrandAccount {
  id                  Int           @id @default(autoincrement())
  name                DeviceBrand
  email               String
  password            String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  devices             Device[]
  tokens              Token[]
  brandAccountStatus  BrandAccountStatus[] 
}

model BrandAccountStatus {
  id                  Int           @id @default(autoincrement())
  integrationActive   Boolean       @default(false)
  brandIdAccount      Int
  lastSync            DateTime      @updatedAt

  brand               BrandAccount? @relation(fields: [brandIdAccount], references: [id])
}
